# Copy to .env and fill in to send real emails. Without SMTP_HOST, emails are saved
# as .eml files in data/outbox/ (preview mode) instead of being sent.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=herocard@yourdomain.com
SMTP_PASS=
MAIL_FROM="HERO Card <herocard@yourdomain.com>"
